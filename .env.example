OPENAI_API_KEY=replace-with-your-openai-api-key
CHAT_MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=pingo-products-openai-v1
# Optional for a secured Elasticsearch deployment:
# ELASTICSEARCH_API_KEY=
MEMORY_DB=data/memory.sqlite3
SESSION_DB=data/sessions.sqlite3
# Local web profile; set to a CLI --user value to share history and memories.
WEB_USER_ID=local-user

# Optional read-only AWS account diagnostics. Public AWS Knowledge MCP needs no keys.
AWS_DIAGNOSTICS_ENABLED=false
# AWS_PROFILE=pingo-readonly
# AWS_REGION=us-east-1

# Extract useful developer/SME context after each completed reply.
AUTO_MEMORY_ENABLED=true
MEMORY_EXTRACTION_MODEL=gpt-4.1-mini

# Dedicated searchable ADK long-term memory projection (separate from product RAG).
MEMORY_INDEX=pingo-memory-v1
